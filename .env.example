PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=5
MAX_AUDIO_MB=20
MAX_VIDEO_MB=200

# Email verification (Gmail). MAIL_USER = your Gmail, MAIL_PASS = Google App Password.
# Create an App Password at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Yuzu Creation
CODE_TTL_MINUTES=10

# Admin (the owner) - seeded automatically on first boot
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name
ADMIN_BIO=Short intro about you and your art.